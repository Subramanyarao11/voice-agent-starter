# --- Infrastructure -------------------------------------------------------
# Both are optional for local text-mode development: with no DATABASE_URL the
# app falls back to a SQLite file, and with no reachable Redis it falls back to
# an in-process cache. Set both for the real Docker/deployed stack.
# Host-side tools use the offset ports published by docker-compose.yml.
DATABASE_URL=postgresql+psycopg://sahaayak:sahaayak@localhost:5433/sahaayak
REDIS_URL=redis://localhost:6380/0

# --- Models ---------------------------------------------------------------
# Required for agent reasoning, speech-to-text, and the ingestion pipeline.
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-4o-mini
OPENAI_STRUCTURING_MODEL=gpt-4o
# Hard code-level ceiling for OpenAI calls during local development and data
# ingestion. The guard rejects values above $15 and persists usage across runs.
OPENAI_BUDGET_USD=10.0
OPENAI_BUDGET_LEDGER_PATH=data/usage/openai-budget.json
OPENAI_PIPELINE_MAX_RECORDS=20
OPENAI_PIPELINE_MAX_OUTPUT_TOKENS=1200
OPENAI_AGENT_MAX_OUTPUT_TOKENS=600
OPENAI_REVIEW_MODEL=gpt-4o-mini
OPENAI_REVIEW_MAX_OUTPUT_TOKENS=900
OPENAI_REVIEW_MAX_INPUT_CHARACTERS=16000
OPENAI_TRANSCRIPTION_RESERVATION_USD=0.10
# Persistent OpenAI-hosted Vector Store. This is a resource identifier, not an
# API secret. Leave blank for the local sync manifest during development; set
# it explicitly in deployment configuration after the first sync.
OPENAI_VECTOR_STORE_ID=
OPENAI_RAG_MANIFEST_PATH=data/rag/vector-store-manifest.json
OPENAI_RAG_ANSWER_MODEL=gpt-4o-mini
OPENAI_RAG_MAX_RESULTS=5
OPENAI_RAG_MAX_OUTPUT_TOKENS=600
OPENAI_RAG_SEARCH_RESERVATION_USD=0.01
OPENAI_RAG_UPLOAD_RESERVATION_USD=0.0005
OPENAI_RAG_BATCH_RESERVATION_USD=0.01
OPENAI_RAG_MAX_SOURCE_BYTES=900000000

# Text-to-speech. Credits are limited, so synthesised phrases are cached and
# TTS is disabled unless a key is present.
SARVAM_API_KEY=

# --- Tracing --------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Workforce admin ------------------------------------------------------
# Admin routes fail closed when neither value is configured. Use a secret
# manager in deployment; ADMIN_TOKENS_JSON supports {"token":{"role":"observer",
# "actor_id":"ops-readonly"}} entries for least-privilege local/staging roles.
ADMIN_API_TOKEN=
ADMIN_TOKENS_JSON=
# Production workforce access: enable this only after configuring a managed
# OIDC application with a private issuer, exact audience, and MFA policy. When
# enabled, static admin tokens are not accepted.
ADMIN_STATIC_TOKENS_ENABLED=true
ADMIN_OIDC_ENABLED=false
ADMIN_OIDC_ISSUER_URL=
# Optional internal discovery URL for Docker split-horizon networking. The
# issuer above must remain the exact URL written into OIDC token `iss` claims.
ADMIN_OIDC_DISCOVERY_URL=
ADMIN_OIDC_AUDIENCE=
ADMIN_OIDC_JWKS_URL=
ADMIN_OIDC_ALLOWED_ALGORITHMS=RS256
ADMIN_OIDC_REQUIRED_AMR=mfa
ADMIN_OIDC_REQUIRED_ACR=
ADMIN_OIDC_ROLES_CLAIM=roles
ADMIN_OIDC_ACTOR_CLAIM=sub
ADMIN_OIDC_CLOCK_SKEW_SECONDS=60
ADMIN_OIDC_JWKS_CACHE_SECONDS=3600
# The Docker Keycloak overlay is convenient for local development. Replace all
# local defaults and use TLS, a real hostname, and durable secrets in production.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# --- Guest sessions and abuse controls ------------------------------------
GUEST_SESSION_TTL_HOURS=720
RATE_LIMIT_TEXT_PER_SESSION=20
RATE_LIMIT_TEXT_PER_IP=60
RATE_LIMIT_VOICE_PER_SESSION=3
RATE_LIMIT_VOICE_PER_IP=10
RATE_LIMIT_RAG_PER_SESSION=10
RATE_LIMIT_RAG_PER_IP=30
RATE_LIMIT_SESSION_CREATE_PER_IP=10
RATE_LIMIT_WINDOW_SECONDS=60
# Set a secret value in staging/production; never log Redis limiter keys.
RATE_LIMIT_KEY_SALT=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true

# --- OpenTelemetry --------------------------------------------------------
# Set either an OTLP base endpoint or explicit traces/metrics endpoints.
OTEL_SERVICE_NAME=sahaayak-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_CONSOLE_EXPORTER=false
OTEL_SAMPLE_RATIO=1.0

# --- Data lifecycle --------------------------------------------------------
RETENTION_TRANSCRIPT_DAYS=30
RETENTION_TELEMETRY_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_ESCALATION_DAYS=365
RETENTION_EXPIRED_SESSION_DAYS=7

# --- Telephony webhook seam ------------------------------------------------
# Disabled until a provider and a secret are configured. The generic adapter
# authenticates requests with X-Telephony-Timestamp and
# X-Telephony-Signature: sha256=<HMAC-SHA256(timestamp.caller_id.audio_sha256)>.
TELEPHONY_ENABLED=false
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_PROVIDER=generic
TELEPHONY_MAX_TIMESTAMP_SKEW_SECONDS=300

# --- Infobip messaging seam ------------------------------------------------
# All channels are disabled by default. Enabling one here is necessary but not
# sufficient: SMS additionally needs Indian DLT entity/header/template
# registration, email needs a verified sending domain with SPF/DKIM/DMARC, and
# WhatsApp needs an approved WABA sender and approved templates. See
# docs/infobip-operations.md before switching anything to true.
#
# INFOBIP_BASE_URL is the account's personalized host and is not a secret.
# INFOBIP_API_KEY and INFOBIP_WEBHOOK_AUTH_SECRET are secrets: keep them in the
# server secret store, never in a Vite variable or the browser.
INFOBIP_ENABLED=false
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_ENVIRONMENT=development

INFOBIP_SMS_ENABLED=false
INFOBIP_SMS_SENDER=

INFOBIP_WHATSAPP_ENABLED=false
INFOBIP_WHATSAPP_SENDER=

INFOBIP_EMAIL_ENABLED=false
INFOBIP_EMAIL_SENDER=
INFOBIP_EMAIL_SENDER_NAME=Sahaayak

INFOBIP_VOICE_ENABLED=false
INFOBIP_VOICE_NUMBER=
INFOBIP_CALLS_CONFIGURATION_ID=
INFOBIP_CALLS_SUBSCRIPTION_ID=

# Shared secret for provider callbacks. Sent as X-Infobip-Webhook-Secret and
# compared in constant time. Provider webhooks never use the browser bearer
# token or an admin token.
INFOBIP_WEBHOOK_AUTH_SECRET=
INFOBIP_REQUEST_TIMEOUT_SECONDS=10
INFOBIP_MAX_RETRIES=2
INFOBIP_MAX_WEBHOOK_BYTES=262144

# Messaging spend is tracked separately from the OpenAI USD ledger, in minor
# units with an explicit currency, because telecom billing is not in dollars.
INFOBIP_COST_CURRENCY=INR
INFOBIP_DAILY_BUDGET_MINOR_UNITS=
INFOBIP_MONTHLY_BUDGET_MINOR_UNITS=

# Fernet key encrypting contact destinations at rest. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; \
#     print(Fernet.generate_key().decode())"
# Without it, external notification channels stay disabled rather than storing
# a phone number or email address in plaintext. Rotating this key makes
# existing stored destinations undecryptable, so rotate deliberately.
INFOBIP_CONTACT_ENCRYPTION_KEY=

SMS_MAX_SEGMENTS=4
CONTACT_VERIFICATION_CODE_TTL_SECONDS=600
CONTACT_VERIFICATION_MAX_ATTEMPTS=5
RATE_LIMIT_CONTACT_VERIFY_PER_SESSION=5
RATE_LIMIT_CONTACT_VERIFY_PER_IP=20

# --- Application ----------------------------------------------------------
ENV=development
LOG_JSON=false
DEFAULT_LANGUAGE=kn
DEFAULT_STATE=KA
WEB_BASE_URL=http://localhost:5173

# --- Production Compose ---------------------------------------------------
# Required only by docker-compose.production.yml; keep these out of Git.
POSTGRES_PASSWORD=
RATE_LIMIT_KEY_SALT=
API_WORKERS=2
WEB_PORT=5173
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
PROMETHEUS_RETENTION=15d
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
RETENTION_INTERVAL_SECONDS=3600
