# --- Infrastructure -------------------------------------------------------
# Both are optional for local text-mode development: with no DATABASE_URL the
# app falls back to a SQLite file, and with no reachable Redis it falls back to
# an in-process cache. Set both for the real Docker/deployed stack.
DATABASE_URL=postgresql+psycopg://sahaayak:sahaayak@localhost:5432/sahaayak
REDIS_URL=redis://localhost:6379/0

# --- Models ---------------------------------------------------------------
# Required for agent reasoning, speech-to-text, and the ingestion pipeline.
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-4o-mini
OPENAI_STRUCTURING_MODEL=gpt-4o

# Text-to-speech. Credits are limited, so synthesised phrases are cached and
# TTS is disabled unless a key is present.
SARVAM_API_KEY=

# --- Tracing --------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Application ----------------------------------------------------------
ENV=development
LOG_JSON=false
DEFAULT_LANGUAGE=kn
DEFAULT_STATE=KA
WEB_BASE_URL=http://localhost:5173
