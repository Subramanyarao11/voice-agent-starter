# --- Infrastructure -------------------------------------------------------
# Both are optional for local text-mode development: with no DATABASE_URL the
# app falls back to a SQLite file, and with no reachable Redis it falls back to
# an in-process cache. Set both for the real Docker/deployed stack.
DATABASE_URL=postgresql+psycopg://sahaayak:sahaayak@localhost:5432/sahaayak
REDIS_URL=redis://localhost:6379/0

# --- Models ---------------------------------------------------------------
# Required for agent reasoning, speech-to-text, and the ingestion pipeline.
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-4o-mini
OPENAI_STRUCTURING_MODEL=gpt-4o
# Hard code-level ceiling for OpenAI calls during local development and data
# ingestion. The guard rejects values above $15 and persists usage across runs.
OPENAI_BUDGET_USD=10.0
OPENAI_BUDGET_LEDGER_PATH=data/usage/openai-budget.json
OPENAI_PIPELINE_MAX_RECORDS=20
OPENAI_PIPELINE_MAX_OUTPUT_TOKENS=1200
OPENAI_AGENT_MAX_OUTPUT_TOKENS=600
OPENAI_REVIEW_MODEL=gpt-4o-mini
OPENAI_REVIEW_MAX_OUTPUT_TOKENS=900
OPENAI_REVIEW_MAX_INPUT_CHARACTERS=16000
OPENAI_TRANSCRIPTION_RESERVATION_USD=0.10
# Persistent OpenAI-hosted Vector Store. This is a resource identifier, not an
# API secret. Leave blank for the local sync manifest during development; set
# it explicitly in deployment configuration after the first sync.
OPENAI_VECTOR_STORE_ID=
OPENAI_RAG_MANIFEST_PATH=data/rag/vector-store-manifest.json
OPENAI_RAG_ANSWER_MODEL=gpt-4o-mini
OPENAI_RAG_MAX_RESULTS=5
OPENAI_RAG_MAX_OUTPUT_TOKENS=600
OPENAI_RAG_SEARCH_RESERVATION_USD=0.01
OPENAI_RAG_UPLOAD_RESERVATION_USD=0.0005
OPENAI_RAG_BATCH_RESERVATION_USD=0.01
OPENAI_RAG_MAX_SOURCE_BYTES=900000000

# Text-to-speech. Credits are limited, so synthesised phrases are cached and
# TTS is disabled unless a key is present.
SARVAM_API_KEY=

# --- Tracing --------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Workforce admin ------------------------------------------------------
# Admin routes fail closed when neither value is configured. Use a secret
# manager in deployment; ADMIN_TOKENS_JSON supports {"token":{"role":"observer",
# "actor_id":"ops-readonly"}} entries for least-privilege local/staging roles.
ADMIN_API_TOKEN=
ADMIN_TOKENS_JSON=

# --- Application ----------------------------------------------------------
ENV=development
LOG_JSON=false
DEFAULT_LANGUAGE=kn
DEFAULT_STATE=KA
WEB_BASE_URL=http://localhost:5173
