# Browser-side OIDC settings for the local Keycloak Compose profile.
VITE_ADMIN_OIDC_ISSUER=http://localhost:8080/realms/sahaayak
VITE_ADMIN_OIDC_CLIENT_ID=sahaayak-admin
VITE_ADMIN_OIDC_REDIRECT_URI=http://localhost:5173/admin/callback
VITE_ADMIN_OIDC_SCOPE=openid profile email
# Keep false when OIDC is the only accepted workforce login.
VITE_ADMIN_ALLOW_MANUAL_TOKEN=false

# Citizen OIDC/BFF browser flow. The browser receives only an HttpOnly cookie;
# the API performs the PKCE code exchange and stores provider tokens server-side.
VITE_CITIZEN_OIDC_ISSUER=http://localhost:8080/realms/sahaayak-citizen
VITE_CITIZEN_OIDC_CLIENT_ID=sahaayak-citizen-web
VITE_CITIZEN_OIDC_REDIRECT_URI=http://localhost:5173/account/callback
VITE_CITIZEN_OIDC_SCOPE=openid profile email
VITE_CITIZEN_OIDC_BFF_ENABLED=false
